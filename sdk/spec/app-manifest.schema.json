{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruxeonrx.org/spec/app-manifest/v1",
  "title": "RuxeonRX application manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "source", "package_kind", "runtime_kind", "launch", "data_dir", "diagnostics_dir", "requested_permissions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "package_kind": {"enum": ["deb", "portable", "desktop-entry", "test"]},
    "runtime_kind": {"enum": ["native-linux", "windows", "android", "web", "vm"]},
    "launch": {"type": "object", "required": ["command"], "properties": {"command": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "data_dir": {"type": "string", "minLength": 1},
    "diagnostics_dir": {"type": "string", "minLength": 1},
    "requested_permissions": {"type": "array", "items": {"enum": ["files", "notifications", "camera", "microphone", "location", "clipboard", "screen-capture", "network", "background"]}}
  }
}
