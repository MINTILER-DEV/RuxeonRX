<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="RuxeonRX">
    <item label="RX Recovery">
      <action name="Execute"><command>python3 /opt/RuxeonRX/shell/modern.py --page recovery</command></action>
    </item>
    <item label="Terminal">
      <action name="Execute"><command>xterm -title "RuxeonRX Terminal"</command></action>
    </item>
    <separator />
