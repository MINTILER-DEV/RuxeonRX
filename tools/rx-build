#!/usr/bin/env bash
# Complete RX 0.5 guest workflow. Legacy proof image lives in rx-health-build.
set -euo pipefail
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
action="${1:-help}"
shift || true
case "$action" in
  bootstrap|doctor)
    python3 - <<'PY'
import json, shutil, sys
tools = ('python3', 'qemu-system-x86_64', 'qemu-img', 'ssh', 'scp', 'ssh-keygen', 'xorriso')
found = {name: bool(shutil.which(name)) for name in tools}
print(json.dumps(found, indent=2))
sys.exit(0 if all(found.values()) else 2)
PY
    ;;
  build) exec python3 "$root/tools/rx-image.py" "$@" ;;
  run) exec python3 "$root/tools/rx-vm.py" "$@" ;;
  test) exec python3 "$root/tools/rx-vm.py" --test "$@" ;;
  safe)
    exec python3 "$root/tools/rx-vm.py" --safe "$@"
    ;;
  bundle)
    exec python3 "$root/tools/rxctl" support-bundle "$root/out/support.zip"
    ;;
  clean)
    echo 'Archive out/desktop explicitly: it contains persistent user data. Clean never deletes VM disks.'
    ;;
  *) echo "usage: $0 {bootstrap|build|run|test|doctor|bundle|clean} [options]" >&2; exit 64 ;;
esac
