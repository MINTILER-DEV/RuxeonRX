#!/usr/bin/env bash
# Complete RX 1.0 guest workflow. Legacy proof image lives in rx-health-build.
set -euo pipefail
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
action="${1:-help}"
shift || true
case "$action" in
  bootstrap|doctor)
    python3 - <<'PY'
import json, shutil, sys
tools = ('python3', 'qemu-system-x86_64', 'qemu-img', 'ssh', 'scp', 'ssh-keygen', 'xorriso')
found = {name: bool(shutil.which(name)) for name in tools}
print(json.dumps(found, indent=2))
sys.exit(0 if all(found.values()) else 2)
PY
    ;;
  build) exec python3 "$root/tools/rx-image.py" "$@" ;;
  export) exec python3 "$root/tools/rx-export.py" "$@" ;;
  run) exec python3 "$root/tools/rx-vm.py" "$@" ;;
  test) exec python3 "$root/tools/rx-vm.py" --test "$@" ;;
  safe)
    exec python3 "$root/tools/rx-vm.py" --safe "$@"
    ;;
  bundle)
    exec python3 "$root/tools/rx-support.py"
    ;;
  clean)
    python3 - "$root" <<'PY'
from pathlib import Path
import sys
out = Path(sys.argv[1]).resolve() / 'out/desktop'
for name in ('source.tar.gz', 'seed.iso'):
    target = out / name
    if target.is_file() and not target.is_symlink():
        target.unlink()
        print('Removed regenerable staging file:', target)
print('VM disks, SSH keys, cached base and diagnostic evidence preserved.')
PY
    ;;
  *) echo "usage: $0 {bootstrap|build|export|run|test|safe|doctor|bundle|clean} [options]" >&2; exit 64 ;;
esac
